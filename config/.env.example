# ============================================================================
# Project Alpha: 環境設定テンプレート
# 本ファイルを .env にコピーして、各設定値を入力してください
# ============================================================================

# ============================================================================
# PostgreSQL 設定
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alpha_db
DB_USER=app_user
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=10

# ============================================================================
# LLM API キー
# ============================================================================

# OpenAI API (GPT-4o)
OPENAI_API_KEY=sk-...your-openai-api-key...

# Anthropic API (Claude)
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-api-key...

# Google Gemini API
GEMINI_API_KEY=your-google-gemini-api-key

# ============================================================================
# Webhook & サーバー設定
# ============================================================================

# Flask Webhookサーバーのポート
WEBHOOK_PORT=5000
WEBHOOK_HOST=0.0.0.0

# IFTTT Webhook URLの認証トークン（セキュリティ用）
IFTTT_WEBHOOK_SECRET=your_secret_token_here

# ============================================================================
# Reddit API 設定
# ============================================================================
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=AutoTradingBot/1.0

# ============================================================================
# 証券会社 API 設定
# ============================================================================

# auカブコム証券 kabuステーション
KABU_API_KEY=your_kabu_api_key
KABU_API_URL=https://kabustation.jpx.co.jp

# Interactive Brokers (米国株用)
IB_ACCOUNT_ID=your_ib_account_id
IB_API_URL=https://api.interactivebrokers.com

# ============================================================================
# X (Twitter) 監視対象アカウント
# ============================================================================

# カンマ区切りで複数指定可能
MONITORED_X_ACCOUNTS=@investor_a,@stock_news_b,@analyst_c

# ============================================================================
# ニュース・情報源設定
# ============================================================================

# RSSフィードURL（カンマ区切り）
RSS_FEEDS=https://news.yahoo.com/rss,https://news.google.com/rss/search?q=日本株

# Google News API（オプション）
GOOGLE_NEWS_API_KEY=your_google_news_api_key

# ============================================================================
# Reddit 監視対象
# ============================================================================

# 監視対象サブレディット（カンマ区切り）
REDDIT_SUBREDDITS=stocks,investing,SecurityAnalysis

# ============================================================================
# ポートフォリオ・リスク管理設定
# ============================================================================

# 総資産額（円）
TOTAL_ASSETS=1000000

# リスク管理パラメータ
MAX_LOSS_PER_TRADE=0.01         # 1回あたりの最大損失率（%）
MAX_LOSS_DAILY=0.05             # 1日あたりの最大損失率（%）
MAX_POSITION_SIZE=0.20          # 1銘柄あたりの最大ポジション（%）

# 短期トレード配分
SHORT_TERM_RATIO=0.30           # 短期トレード：30%
LONG_TERM_RATIO=0.50            # 長期保有：50%
CASH_RESERVE_RATIO=0.20         # 現金予備：20%

# ============================================================================
# LLM 分析パラメータ
# ============================================================================

# 売買実行の最低信頼度スコア
MIN_CONFIDENCE_SCORE=0.75       # 75%以上の信頼度で売買実行

# LLMの同意度（複数モデルの結果のばらつき）
MAX_ALLOWED_STDDEV=15.0         # 標準偏差15.0以内なら EXECUTE

# ============================================================================
# ロギング設定
# ============================================================================

# ログレベル: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ログファイルパス
LOG_FILE_PATH=logs/app.log

# ============================================================================
# スケジューラ設定
# ============================================================================

# データ処理の定期実行間隔（秒）
DATA_PROCESSING_INTERVAL=5

# LLM分析の定期実行間隔（秒）
LLM_ANALYSIS_INTERVAL=60

# コンセンサス更新の定期実行間隔（秒）
CONSENSUS_UPDATE_INTERVAL=60

# 売買シグナルチェックの定期実行間隔（秒）
TRADING_CHECK_INTERVAL=10

# ニュース取得の定期実行間隔（秒）
NEWS_FETCH_INTERVAL=1800        # 30分ごと

# ============================================================================
# 本番環境フラグ
# ============================================================================

# True: 本番モード（実際に売買を実行）
# False: シミュレーションモード（売買は実行しない）
PRODUCTION_MODE=False

# ============================================================================
# デバッグ・開発設定
# ============================================================================

DEBUG=False
VERBOSE=False

# ============================================================================
# その他
# ============================================================================

# タイムゾーン
TIMEZONE=Asia/Tokyo

# データ保持期間（日数）
DATA_RETENTION_DAYS=365
