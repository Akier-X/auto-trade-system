# ===================================
# Auto Trade System - Backend Configuration
# ===================================

# Server Configuration
PORT=3001
NODE_ENV=development

# ===================================
# Database Configuration (TimescaleDB)
# ===================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# ===================================
# API Keys - AI Services
# ===================================

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===================================
# API Keys - External Services
# ===================================

# News API (newsapi.org)
NEWS_API_KEY=your_news_api_key_here

# Alpha Vantage (Stock data alternative)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ===================================
# Notification Services
# ===================================

# LINE Bot
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL_ID=your_slack_channel_id

# ===================================
# OAuth 2.0 Configuration
# ===================================

# Google OAuth (for Calendar, Gmail, etc.)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google-auth/callback

# Google Calendar
GOOGLE_CALENDAR_ID=primary

# X/Twitter OAuth 1.0a
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ===================================
# Security & Session
# ===================================

# Session Secret (for OAuth flows)
SESSION_SECRET=your_random_session_secret_here

# JWT Secret (if using JWT authentication)
JWT_SECRET=your_jwt_secret_here

# CORS Origin (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ===================================
# Feature Flags
# ===================================

# Enable/Disable Features
ENABLE_AUTO_TRADING=false
ENABLE_STOCK_RECORDING=true
ENABLE_NEWS_MONITORING=true
ENABLE_X_MONITORING=true

# ===================================
# Automation & Scheduling
# ===================================

# Cron Job Settings (use cron syntax)
STOCK_FETCH_CRON=0 */6 * * *
NEWS_FETCH_CRON=0 * * * *
X_MONITOR_CRON=*/5 * * * *

# ===================================
# Rate Limiting & Performance
# ===================================

# API Rate Limits (requests per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Settings
CACHE_TTL_SECONDS=300

# ===================================
# Logging & Monitoring
# ===================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Sentry DSN (Error Tracking)
SENTRY_DSN=your_sentry_dsn_here

# ===================================
# Development & Testing
# ===================================

# Enable Debug Mode
DEBUG=false

# Mock External APIs (for testing)
MOCK_YAHOO_FINANCE=false
MOCK_NEWS_API=false

# ===================================
# Notes
# ===================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env file to version control
# 3. Keep API keys secure and rotate them regularly
# 4. Use environment-specific .env files (.env.development, .env.production)
