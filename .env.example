# ============================================================================
# Auto Trade System - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auto_trade_system
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ----------------------------------------------------------------------------
# API Keys - LLM Providers
# ----------------------------------------------------------------------------

# OpenAI API (for GPT-4o, GPT-4 Turbo, Embeddings)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API (for Claude 3.5 Sonnet, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google Gemini API (for Gemini 1.5 Pro)
GOOGLE_API_KEY=your-google-gemini-api-key-here

# ----------------------------------------------------------------------------
# Data Source APIs
# ----------------------------------------------------------------------------

# Reddit API (for r/stocks, r/investing monitoring)
# Get credentials at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=AutoTradingBot/1.0

# Twitter/X API (optional - if not using IFTTT)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# ----------------------------------------------------------------------------
# Webhook Server Configuration
# ----------------------------------------------------------------------------
WEBHOOK_PORT=5000
FLASK_DEBUG=False
FLASK_ENV=production

# ----------------------------------------------------------------------------
# Trading API Configuration
# ----------------------------------------------------------------------------

# auカブコム証券 (kabu Station API)
KABU_API_KEY=your_kabu_api_key
KABU_API_PASSWORD=your_kabu_password

# Interactive Brokers (for US stocks)
IB_ACCOUNT_ID=your_ib_account_id
IB_API_PORT=7497

# ----------------------------------------------------------------------------
# System Configuration
# ----------------------------------------------------------------------------

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timezone
TZ=Asia/Tokyo

# ----------------------------------------------------------------------------
# Optional: Supabase Configuration
# ----------------------------------------------------------------------------
# If using Supabase instead of local PostgreSQL

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----------------------------------------------------------------------------
# Optional: Cloud Deployment
# ----------------------------------------------------------------------------

# Render.com
# RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Heroku
# HEROKU_APP_NAME=your-heroku-app-name

# ----------------------------------------------------------------------------
# Optional: Monitoring & Alerts
# ----------------------------------------------------------------------------

# Slack Webhook (for alerts)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email Alerts
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-email-password
# ALERT_EMAIL=alerts@yourdomain.com

# ----------------------------------------------------------------------------
# Risk Management Settings
# ----------------------------------------------------------------------------

# Maximum loss per trade (percentage of total assets)
MAX_LOSS_PER_TRADE=0.01

# Maximum daily loss (percentage of total assets)
MAX_LOSS_DAILY=0.05

# Initial capital (JPY)
INITIAL_CAPITAL=1000000

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------

# Enable/disable automatic trading execution
AUTO_TRADE_ENABLED=False

# Enable/disable data collection
DATA_COLLECTION_ENABLED=True

# Enable/disable AI analysis
AI_ANALYSIS_ENABLED=True

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------

# Run in development mode
DEV_MODE=True

# Use sample data for testing
USE_SAMPLE_DATA=True
